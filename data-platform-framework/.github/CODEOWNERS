# Last matching rule wins. Owners are auto-requested and their approval is required.

# Default: platform owns anything unassigned
*                               @org/de-platform

# Domains
/domains/sales/                 @org/de-sales
/domains/finance/               @org/de-finance
/domains/customer/              @org/de-customer

# Contracts are a public API: domain owner AND platform must approve
/domains/sales/contracts/       @org/de-sales @org/de-platform
/domains/finance/contracts/     @org/de-finance @org/de-platform
/domains/customer/contracts/    @org/de-customer @org/de-platform

# Sample data for local builds belongs to the domain
/sample_data/sales_*            @org/de-sales
/sample_data/finance_*          @org/de-finance
/sample_data/customer_*         @org/de-customer

# Shared code, infra, guardrails
/dbt_project.yml                @org/de-platform
/profiles.yml                   @org/de-platform
/macros/                        @org/de-platform
/stack.yaml                     @org/de-platform
/stacks/                        @org/de-platform
/libs/                          @org/de-platform
/platform/                      @org/de-platform
/tools/                         @org/de-platform
/.github/                       @org/de-platform
/.vscode/                       @org/de-platform

# Architecture and AI context: Architecture Guild
/ARCHITECTURE.md                @org/de-architecture-guild
/AGENTS.md                      @org/de-architecture-guild
/docs/adr/                      @org/de-architecture-guild
/.github/instructions/          @org/de-architecture-guild
/.github/prompts/               @org/de-architecture-guild
/.github/agents/                @org/de-architecture-guild
