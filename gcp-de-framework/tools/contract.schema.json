{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data contract",
  "description": "Schema for domains/*/contracts/*.yaml. Gives autocomplete and validation in VS Code.",
  "type": "object",
  "required": ["name", "domain", "layer", "version", "owner", "description", "columns"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "domain": { "type": "string", "enum": ["sales", "finance", "customer"] },
    "layer": { "type": "string", "enum": ["bronze", "silver", "gold"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string", "pattern": "^@" },
    "description": { "type": "string", "minLength": 10 },
    "partition_by": { "type": "string" },
    "cluster_by": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
    "sla": {
      "type": "object",
      "properties": { "freshness_hours": { "type": "integer", "minimum": 1 } }
    },
    "deprecated": {
      "type": "object",
      "description": "Set when a newer major version replaces this table.",
      "properties": { "replaced_by": { "type": "string" }, "sunset_date": { "type": "string", "format": "date" } }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "mode"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["STRING", "INT64", "NUMERIC", "BIGNUMERIC", "FLOAT64", "BOOL", "DATE", "DATETIME", "TIMESTAMP", "JSON", "BYTES", "GEOGRAPHY"] },
          "mode": { "enum": ["REQUIRED", "NULLABLE", "REPEATED"] },
          "description": { "type": "string" },
          "pii": { "type": "boolean" },
          "policy_tag": { "type": "string" }
        }
      }
    }
  }
}
