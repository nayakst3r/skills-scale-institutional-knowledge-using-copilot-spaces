config {
  type: "table",
  schema: "finance_gold",
  name: "revenue_eur_daily",
  bigquery: { partitionBy: "order_date" },
  assertions: { nonNull: ["order_date", "revenue_eur"], uniqueKey: ["order_date", "channel"] }
}

-- Reads Sales through its public gold table (P3), never sales_silver.
SELECT
  r.order_date,
  r.channel,
  SUM(r.order_count) AS order_count,
  SUM(r.revenue * fx.rate) AS revenue_eur
FROM ${ref("sales_gold", "revenue_daily")} AS r
INNER JOIN ${ref("finance_silver", "fx_rates")} AS fx
  ON fx.rate_date = r.order_date
  AND fx.from_currency = r.currency
  AND fx.to_currency = "EUR"
GROUP BY r.order_date, r.channel
