config {
  type: "table",
  schema: "sales_gold",
  name: "revenue_daily",
  bigquery: { partitionBy: "order_date" },
  assertions: { nonNull: ["order_date", "currency"], uniqueKey: ["order_date", "currency", "channel"] }
}

SELECT
  order_date,
  currency,
  channel,
  COUNT(*) AS order_count,
  SUM(amount) AS revenue,
  SAFE_DIVIDE(SUM(amount), COUNT(*)) AS avg_order_value
FROM ${ref("sales_silver", "orders")}
GROUP BY order_date, currency, channel
