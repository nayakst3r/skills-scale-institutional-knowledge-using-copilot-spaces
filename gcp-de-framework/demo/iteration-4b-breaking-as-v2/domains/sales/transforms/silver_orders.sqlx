config {
  type: "incremental",
  schema: "sales_silver",
  name: "orders",
  uniqueKey: ["order_id"],
  bigquery: { partitionBy: "order_date", clusterBy: ["customer_id"] },
  assertions: { nonNull: ["order_id", "customer_id", "order_date"], uniqueKey: ["order_id"] }
}

SELECT
  order_id,
  customer_id,
  customer_email,
  DATE(order_ts) AS order_date,
  CAST(amount AS NUMERIC) AS amount,
  UPPER(currency) AS currency,
  channel,
  region
FROM ${ref("sales_bronze", "raw_orders")}
WHERE TRUE
  ${when(incremental(), `AND DATE(order_ts) >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)`)}
QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY ingested_at DESC) = 1
