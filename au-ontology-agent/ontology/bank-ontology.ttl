@prefix bank: <https://example.org/ontology/au-bank#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

bank: a owl:Ontology ;
  dct:title "Australian ADI Ontology — products, parties, regulators, loyalty and scenarios" ;
  dct:description "366 classes across 15 groups, 474 object properties, and 124 traced scenarios with per-bank applicability and regulatory bundles. Built against Westpac, ANZ, NAB, CBA, ING and Macquarie. Replace the namespace before use." ;
  owl:versionInfo "2026-08-22" .

#################### Upper classes ####################

bank:Concept a owl:Class ; rdfs:label "Concept" .
bank:Scenario a owl:Class ; rdfs:label "Scenario" .
bank:ScenarioStep a owl:Class ; rdfs:label "Scenario Step" .
bank:Bank a owl:Class ; rdfs:label "Bank" .
bank:ClassGroup a owl:Class ; rdfs:label "Class Group" .
bank:RegulatoryReference a owl:Class ; rdfs:label "Regulatory Reference" .
bank:Applicability a owl:Class ; rdfs:label "Applicability" .

#################### Class groups ####################

bank:Party a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Party" ;
  skos:note "group" .

bank:PartyRole a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Party Role" ;
  skos:note "group" .

bank:DepositsAccounts a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Deposits & Accounts" ;
  skos:note "group" .

bank:CreditSecurity a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Credit & Security" ;
  skos:note "group" .

bank:MarketsWealthService a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Markets, Wealth & Service" ;
  skos:note "group" .

bank:Product a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Product" ;
  skos:note "group" .

bank:Event a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Event" ;
  skos:note "group" .

bank:AssetSecurity a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Asset & Security" ;
  skos:note "group" .

bank:LocationChannel a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Location & Channel" ;
  skos:note "group" .

bank:RegulatoryObject a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Regulatory Object" ;
  skos:note "group" .

bank:Insurance a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Insurance" ;
  skos:note "group" .

bank:SchemesRails a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Schemes & Rails" ;
  skos:note "group" .

bank:ProvidersUnderwriters a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Providers & Underwriters" ;
  skos:note "group" .

bank:RegulatorsBodies a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Regulators & Bodies" ;
  skos:note "group" .

bank:LoyaltyRewards a owl:Class ;
  rdfs:subClassOf bank:Concept ;
  rdfs:label "Loyalty & Rewards" ;
  skos:note "group" .

