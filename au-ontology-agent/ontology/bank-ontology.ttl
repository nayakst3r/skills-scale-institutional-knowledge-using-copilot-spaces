#################### Scenarios ####################

bank:Scenario_Broker a owl:NamedIndividual, bank:Scenario ;
  rdfs:label "Broker-originated home loan" ;
  dct:subject "Origination" ;
  skos:definition "The dominant path, but the mix differs sharply by bank." ;
  skos:scopeNote "Responsible lending under the National Credit Code applies; business-purpose lending is exempt." ;
  bank:validationStatus "validated" ;
  bank:regulatoryReference "APRA APS 112/113/220" ;
  bank:regulatoryReference "ARF 743/744" ;
  bank:regulatoryReference "ASIC ACL + NCCP" ;
  bank:regulatoryReference "DDO / TMD" ;
  bank:regulatoryReference "AUSTRAC designated service" ;
  bank:regulatoryReference "ABA Code B4" ;
  bank:regulatoryReference "CDR" ;
  bank:applicability [ bank:bank "Westpac" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "ANZ" ; bank:status "applicable" ; rdfs:comment "Broker ~62% and rising." ] ;
  bank:applicability [ bank:bank "NAB" ; bank:status "appliesWithVariation" ; rdfs:comment "Broker 53.8% and falling." ] ;
  bank:applicability [ bank:bank "CBA" ; bank:status "applicable" ; rdfs:comment "Proprietary ~67-68%; broker only ~32%." ] ;
  bank:applicability [ bank:bank "ING" ; bank:status "appliesWithVariation" ; rdfs:comment "Broker-only, single brand." ] ;
  bank:applicability [ bank:bank "Macquarie" ; bank:status "appliesWithVariation" ; rdfs:comment "Broker-dominant, no branch alternative." ] ;
  bank:step [ bank:order 1 ; bank:subject bank:Person ; bank:predicate bank:plays ; bank:object bank:Broker ] ;
  bank:step [ bank:order 2 ; bank:subject bank:BrokerChannel ; bank:predicate bank:operatesVia ; bank:object bank:Broker ] ;
  bank:step [ bank:order 3 ; bank:subject bank:Broker ; bank:predicate bank:originates ; bank:object bank:Application ] ;
  bank:step [ bank:order 4 ; bank:subject bank:Aggregator ; bank:predicate bank:accredits ; bank:object bank:Broker ] ;
  bank:step [ bank:order 5 ; bank:subject bank:Applicant ; bank:predicate bank:lodges ; bank:object bank:Application ] ;
  bank:step [ bank:order 6 ; bank:subject bank:Application ; bank:predicate bank:triggers ; bank:object bank:CreditAssessment ] ;
  bank:step [ bank:order 7 ; bank:subject bank:Application ; bank:predicate bank:resultsIn ; bank:object bank:Facility ] ;
  bank:step [ bank:order 8 ; bank:subject bank:Facility ; bank:predicate bank:securedOver ; bank:object bank:SecurityProperty ] ;
  bank:step [ bank:order 9 ; bank:subject bank:Facility ; bank:predicate bank:reportedIn ; bank:object bank:EFSARFReturn ] .

bank:Scenario_Digital a owl:NamedIndividual, bank:Scenario ;
  rdfs:label "Digital opening, KYC and ConnectID" ;
  dct:subject "Origination" ;
  skos:definition "Identity now increasingly verified through ConnectID, the bank-owned digital identity exchange enabled by all four majors in January 2025." ;
  skos:scopeNote "Corrected: FCS Coverage and CDR Scope Status are now explicit classes on every deposit account." ;
  bank:validationStatus "corrected" ;
  bank:regulatoryReference "AUSTRAC designated service" ;
  bank:regulatoryReference "ASIC AFSL" ;
  bank:regulatoryReference "DDO / TMD" ;
  bank:regulatoryReference "CDR" ;
  bank:regulatoryReference "ATO TFN/AIIR" ;
  bank:regulatoryReference "APRA APS 210" ;
  bank:applicability [ bank:bank "Westpac" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "ANZ" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "NAB" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "CBA" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "ING" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "Macquarie" ; bank:status "applicable" ] ;
  bank:step [ bank:order 1 ; bank:subject bank:Person ; bank:predicate bank:verifiedBy ; bank:object bank:DigitalIdentityConnectID ] ;
  bank:step [ bank:order 2 ; bank:subject bank:ConnectID ; bank:predicate bank:operates ; bank:object bank:DigitalIdentityConnectID ] ;
  bank:step [ bank:order 3 ; bank:subject bank:DocumentVerificationService ; bank:predicate bank:verifiesDocumentsFor ; bank:object bank:KYCReview ] ;
  bank:step [ bank:order 4 ; bank:subject bank:DigitalIdentityConnectID ; bank:predicate bank:supports ; bank:object bank:KYCReview ] ;
  bank:step [ bank:order 5 ; bank:subject bank:DigitalChannel ; bank:predicate bank:hosts ; bank:object bank:Interaction ] ;
  bank:step [ bank:order 6 ; bank:subject bank:KYCReview ; bank:predicate bank:verifies ; bank:object bank:Person ] ;
  bank:step [ bank:order 7 ; bank:subject bank:AccountHolder ; bank:predicate bank:holds ; bank:object bank:Account ] ;
  bank:step [ bank:order 8 ; bank:subject bank:Account ; bank:predicate bank:instantiates ; bank:object bank:Product ] ;
  bank:step [ bank:order 9 ; bank:subject bank:Account ; bank:predicate bank:protectedBy ; bank:object bank:FCSCoverage ] ;
  bank:step [ bank:order 10 ; bank:subject bank:Account ; bank:predicate bank:inScopeFor ; bank:object bank:CDRScopeStatus ] .

bank:Scenario_Settle a owl:NamedIndividual, bank:Scenario ;
  rdfs:label "Property settlement through PEXA" ;
  dct:subject "Origination" ;
  skos:definition "Loan funding, title transfer and duty complete together on a platform the bank doesn't own." ;
  skos:scopeNote "Duty Authority is the state revenue office; title identifiers are state-specific." ;
  bank:validationStatus "validated" ;
  bank:regulatoryReference "State / ECNL" ;
  bank:regulatoryReference "ARNECC MPR v7" ;
  bank:regulatoryReference "State revenue (duty)" ;
  bank:regulatoryReference "APRA CPS 230" ;
  bank:applicability [ bank:bank "Westpac" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "ANZ" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "NAB" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "CBA" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "ING" ; bank:status "applicable" ] ;
  bank:applicability [ bank:bank "Macquarie" ; bank:status "applicable" ] ;
  bank:step [ bank:order 1 ; bank:subject bank:Conveyancer ; bank:predicate bank:coordinates ; bank:object bank:Settlement ] ;
  bank:step [ bank:order 2 ; bank:subject bank:Facility ; bank:predicate bank:completesAt ; bank:object bank:Settlement ] ;
  bank:step [ bank:order 3 ; bank:subject bank:Settlement ; bank:predicate bank:transfers ; bank:object bank:SecurityProperty ] ;
  bank:step [ bank:order 4 ; bank:subject bank:TitleInsurance ; bank:predicate bank:mayInsureTitleOf ; bank:object bank:SecurityProperty ] ;
  bank:step [ bank:order 5 ; bank:subject bank:SecurityProperty ; bank:predicate bank:registeredAs ; bank:object bank:TitleReference ] ;
  bank:step [ bank:order 6 ; bank:subject bank:TitleReference ; bank:predicate bank:lodgedIn ; bank:object bank:Jurisdiction ] ;
  bank:step [ bank:order 7 ; bank:subject bank:MaterialServiceProvider ; bank:predicate bank:supports ; bank:object bank:CriticalOperation ] ;
  bank:step [ bank:order 8 ; bank:subject bank:CyberInsurance ; bank:predicate bank:insures ; bank:object bank:CriticalOperation ] .

bank:Scenario_Guarantor a owl:NamedIndividual, bank:Scenario ;
